diff --git a/Makefile b/Makefile
index 451e415..93fcfec 100755
--- a/Makefile
+++ b/Makefile
@@ -6,20 +6,44 @@ ccflags-y += -O1
 #ccflags-y += -pedantic
 #ccflags-y += -Wshadow -Wpointer-arith -Wcast-qual -Wstrict-prototypes -Wmissing-prototypes
 ccflags-y += -Wmissing-prototypes
-ccflags-y += -Werror=missing-prototypes
+#ccflags-y += -Werror=missing-prototypes
 
 ccflags-y += -Wno-unused-variable
-#ccflags-y += -Wno-unused-value
-#ccflags-y += -Wno-unused-label
-#ccflags-y += -Wno-unused-parameter
-#ccflags-y += -Wno-unused-function
+ccflags-y += -Wno-unused-function
+ccflags-y += -Wno-misleading-indentation
+ccflags-y += -Wno-unused-value
+ccflags-y += -Wno-unused-label
+ccflags-y += -Wno-unused-parameter
+ccflags-y += -Wno-implicit-fallthrough
+ccflags-y += -Wno-enum-conversion
+ccflags-y += -Wno-vla
+ccflags-y += -Wno-error
 #ccflags-y += -Wno-unused
 #ccflags-y += -Wno-uninitialized
 
+# Support for both GCC and Clang compilers
+ifeq ($(CC),clang)
+ccflags-y += -Wno-date-time
+ccflags-y += -Wno-gnu-variable-sized-type-not-at-end
+ccflags-y += -Wno-tautological-compare
+ccflags-y += -Wno-missing-field-initializers
+ccflags-y += -Wno-unused-const-variable
+ccflags-y += -Wno-format-security
+ccflags-y += -Wno-initializer-overrides
+ccflags-y += -Wno-uninitialized
+ccflags-y += -Wno-unknown-pragmas
+ccflags-y += -Wno-pragma-pack
+ccflags-y += -Wno-cast-function-type
+ccflags-y += -Wno-parentheses-equality
+ccflags-y += -Wno-undefined-internal
+ccflags-y += -Wno-unused-but-set-variable
+ccflags-y += -Wno-address-of-packed-member
+else
 GCC_VER_49 := $(shell echo `$(CC) -dumpversion | cut -f1-2 -d.` \>= 4.9 | `which bc` )
 ifeq ($(GCC_VER_49),1)
 ccflags-y += -Wno-date-time	# Fix compile error && warning on gcc 4.9 and later
 endif
+endif
 
 ccflags-y += -I$(src)/include
 
@@ -1330,8 +1354,8 @@ ccflags-y += -DCONFIG_IOCTL_CFG80211 -DRTW_USE_CFG80211_STA_EVENT
 SUBARCH := $(shell uname -m | sed -e s/i.86/i386/)
 ARCH ?= $(SUBARCH)
 CROSS_COMPILE ?=
-KVER  := $(shell uname -r)
-KSRC := /lib/modules/$(KVER)/build
+KVER  ?= $(shell uname -r)
+KSRC ?= /lib/modules/$(KVER)/build
 MODDESTDIR := /lib/modules/$(KVER)/kernel/drivers/net/wireless/
 INSTALL_PREFIX :=
 STAGINGMODDIR := /lib/modules/$(KVER)/kernel/drivers/staging
