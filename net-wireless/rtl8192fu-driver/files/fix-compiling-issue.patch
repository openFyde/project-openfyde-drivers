diff --git a/Makefile b/Makefile
index a2b9ff7..faea2fd 100644
--- a/Makefile
+++ b/Makefile
@@ -15,16 +15,35 @@ EXTRA_CFLAGS += -Wno-unused-parameter
 EXTRA_CFLAGS += -Wno-unused-function
 EXTRA_CFLAGS += -Wno-unused
 EXTRA_CFLAGS += -Wno-implicit-fallthrough
-EXTRA_CFLAGS += -Wno-discarded-qualifiers
 EXTRA_CFLAGS += -Wno-cast-function-type
 EXTRA_CFLAGS += -Wno-address
+# Linux 6.9+ enables -Wmissing-prototypes/-Wmissing-declarations by default and
+# CONFIG_WERROR turns them into errors; this old vendor tree has many globals
+# without prototypes, so silence the class instead of touching every file.
+EXTRA_CFLAGS += -Wno-missing-prototypes
+EXTRA_CFLAGS += -Wno-missing-declarations
 #EXTRA_CFLAGS += -Wno-uninitialized
 
+# Compiler detection
+IS_CLANG := $(shell $(CC) --version 2>/dev/null | grep -q clang && echo 1 || echo 0)
+
 GCC_VER_49 := $(shell echo `$(CC) -dumpversion | cut -f1-2 -d.` \>= 4.9 | bc )
 ifeq ($(GCC_VER_49),1)
 EXTRA_CFLAGS += -Wno-date-time	# Fix compile error && warning on gcc 4.9 and later
 endif
 
+# Clang-specific flags
+ifeq ($(IS_CLANG),1)
+EXTRA_CFLAGS += -Wno-enum-conversion
+EXTRA_CFLAGS += -Wno-missing-braces
+EXTRA_CFLAGS += -Wno-sometimes-uninitialized
+EXTRA_CFLAGS += -Wno-tautological-pointer-compare
+EXTRA_CFLAGS += -Wno-incompatible-pointer-types-discards-qualifiers
+EXTRA_CFLAGS += -Wno-strict-prototypes
+else
+EXTRA_CFLAGS += -Wno-discarded-qualifiers
+endif
+
 EXTRA_CFLAGS += -I$(src)/include
 
 EXTRA_LDFLAGS += --strip-debug
