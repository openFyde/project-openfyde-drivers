diff --git a/include/ieee80211.h b/include/ieee80211.h
index 1a31b84..c9d844c 100644
--- a/include/ieee80211.h
+++ b/include/ieee80211.h
@@ -1451,18 +1451,18 @@ enum ieee80211_state {
 	(((Addr[2]) & 0xff) == 0xff) && (((Addr[3]) & 0xff) == 0xff) && (((Addr[4]) & 0xff) == 0xff) && \
 				     (((Addr[5]) & 0xff) == 0xff))
 #else
-extern inline int is_multicast_mac_addr(const u8 *addr)
+static inline int is_multicast_mac_addr(const u8 *addr)
 {
 	return (addr[0] != 0xff) && (0x01 & addr[0]);
 }
 
-extern inline int is_broadcast_mac_addr(const u8 *addr)
+static inline int is_broadcast_mac_addr(const u8 *addr)
 {
 	return ((addr[0] == 0xff) && (addr[1] == 0xff) && (addr[2] == 0xff) &&   \
 		(addr[3] == 0xff) && (addr[4] == 0xff) && (addr[5] == 0xff));
 }
 
-extern inline int is_zero_mac_addr(const u8 *addr)
+static inline int is_zero_mac_addr(const u8 *addr)
 {
 	return ((addr[0] == 0x00) && (addr[1] == 0x00) && (addr[2] == 0x00) &&   \
 		(addr[3] == 0x00) && (addr[4] == 0x00) && (addr[5] == 0x00));
diff --git a/include/rtw_recv.h b/include/rtw_recv.h
index 90abfee..bcca605 100644
--- a/include/rtw_recv.h
+++ b/include/rtw_recv.h
@@ -767,9 +767,11 @@ __inline static union recv_frame *rxmem_to_recvframe(u8 *rxmem)
 
 __inline static union recv_frame *pkt_to_recvframe(_pkt *pkt)
 {
-
 	u8 *buf_star;
 	union recv_frame *precv_frame;
+	
+	/* Extract data buffer from packet */
+	buf_star = pkt->data;
 	precv_frame = rxmem_to_recvframe((unsigned char *)buf_star);
 
 	return precv_frame;
